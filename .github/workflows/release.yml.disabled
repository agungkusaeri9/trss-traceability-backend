name: Release Backend

on:
  push:
    tags:
      - 'v*'
  workflow_dispatch:

permissions:
  contents: write

jobs:
  publish-and-release:
    name: Build & Publish Release
    runs-on: windows-latest

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Setup .NET SDK
        uses: actions/setup-dotnet@v4
        with:
          dotnet-version: '10.0.x'

      - name: Cache NuGet Packages
        uses: actions/cache@v4
        with:
          path: ~/.nuget/packages
          key: ${{ runner.os }}-nuget-${{ hashFiles('**/*.csproj', 'Directory.Build.props') }}
          restore-keys: |
            ${{ runner.os }}-nuget-

      - name: Restore Dependencies
        run: dotnet restore TraceabilitySystem.slnx -r win-x64

      - name: Extract Release Notes from CHANGELOG
        id: changelog
        shell: pwsh
        run: |
          $tag = "${{ github.ref_name }}"
          $escapedTag = [regex]::Escape($tag)
          $content = Get-Content CHANGELOG.md -Raw -ErrorAction SilentlyContinue
          $pattern = "(?ms)## \[$escapedTag\].*?(?=\r?\n---|\Z)"

          if ($content -and ($content -match $pattern)) {
              $notes = $matches[0].Trim()
              $delimiter = [System.Guid]::NewGuid().ToString()
              "notes<<$delimiter`n$notes`n$delimiter" | Out-File -FilePath $env:GITHUB_OUTPUT -Encoding utf8 -Append
              Write-Host "Berhasil mengekstrak changelog untuk $tag"
          } else {
              "notes=" | Out-File -FilePath $env:GITHUB_OUTPUT -Encoding utf8 -Append
              Write-Host "Changelog tidak ditemukan untuk $tag, akan menggunakan auto release notes."
          }

      - name: Build & Package API
        shell: pwsh
        run: |
          $tag = "${{ github.ref_name }}"
          $ver = $tag.TrimStart('v')
          Write-Host "Publishing TraceabilitySystem.API (v$ver)..."

          dotnet publish src/TraceabilitySystem.API/TraceabilitySystem.API.csproj `
            -c Release `
            -r win-x64 `
            --no-restore `
            --no-self-contained `
            -p:Version=$ver `
            -o ./dist/publish-api

          if (!(Test-Path "./dist/publish-api/appsettings.Production.json") -and (Test-Path "./dist/publish-api/appsettings.example.json")) {
              Copy-Item "./dist/publish-api/appsettings.example.json" -Destination "./dist/publish-api/appsettings.Production.json"
          }
          if (!(Test-Path "./dist/publish-api/appsettings.json") -and (Test-Path "./dist/publish-api/appsettings.example.json")) {
              Copy-Item "./dist/publish-api/appsettings.example.json" -Destination "./dist/publish-api/appsettings.json"
          }

          Compress-Archive -Path ./dist/publish-api/* -DestinationPath "./dist/trss-backend-api-$tag-win-x64.zip" -Force

      - name: Build & Package Worker
        shell: pwsh
        run: |
          $tag = "${{ github.ref_name }}"
          $ver = $tag.TrimStart('v')
          Write-Host "Publishing TraceabilitySystem.Worker (v$ver)..."

          dotnet publish src/TraceabilitySystem.Worker/TraceabilitySystem.Worker.csproj `
            -c Release `
            -r win-x64 `
            --no-restore `
            --no-self-contained `
            -p:Version=$ver `
            -o ./dist/publish-worker

          if (!(Test-Path "./dist/publish-worker/appsettings.Production.json") -and (Test-Path "./dist/publish-worker/appsettings.example.json")) {
              Copy-Item "./dist/publish-worker/appsettings.example.json" -Destination "./dist/publish-worker/appsettings.Production.json"
          }
          if (!(Test-Path "./dist/publish-worker/appsettings.json") -and (Test-Path "./dist/publish-worker/appsettings.example.json")) {
              Copy-Item "./dist/publish-worker/appsettings.example.json" -Destination "./dist/publish-worker/appsettings.json"
          }

          Compress-Archive -Path ./dist/publish-worker/* -DestinationPath "./dist/trss-backend-worker-$tag-win-x64.zip" -Force

      - name: Build & Package Backup
        shell: pwsh
        run: |
          $tag = "${{ github.ref_name }}"
          $ver = $tag.TrimStart('v')
          Write-Host "Publishing TraceabilitySystem.Backup (v$ver)..."

          dotnet publish src/TraceabilitySystem.Backup/TraceabilitySystem.Backup.csproj `
            -c Release `
            -r win-x64 `
            --no-restore `
            --no-self-contained `
            -p:Version=$ver `
            -o ./dist/publish-backup

          if (!(Test-Path "./dist/publish-backup/appsettings.Production.json") -and (Test-Path "./dist/publish-backup/appsettings.example.json")) {
              Copy-Item "./dist/publish-backup/appsettings.example.json" -Destination "./dist/publish-backup/appsettings.Production.json"
          }
          if (!(Test-Path "./dist/publish-backup/appsettings.json") -and (Test-Path "./dist/publish-backup/appsettings.example.json")) {
              Copy-Item "./dist/publish-backup/appsettings.example.json" -Destination "./dist/publish-backup/appsettings.json"
          }

          Compress-Archive -Path ./dist/publish-backup/* -DestinationPath "./dist/trss-backend-backup-$tag-win-x64.zip" -Force

      - name: Create GitHub Release & Upload Assets
        uses: softprops/action-gh-release@v2
        with:
          tag_name: ${{ github.ref_name }}
          name: Release ${{ github.ref_name }}
          body: ${{ steps.changelog.outputs.notes }}
          draft: false
          prerelease: false
          generate_release_notes: true
          files: |
            ./dist/trss-backend-api-*.zip
            ./dist/trss-backend-worker-*.zip
            ./dist/trss-backend-backup-*.zip
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
