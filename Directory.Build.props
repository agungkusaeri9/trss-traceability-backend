<Project>
  <PropertyGroup>
    <Version>0.2.5</Version>
    <AssemblyVersion>0.2.5.0</AssemblyVersion>
    <FileVersion>0.2.5.0</FileVersion>
    <InformationalVersion>0.2.5</InformationalVersion>
    <!-- Suppress NuGet audit vulnerability warnings from breaking msbuild / dotnet watch -->
    <NoWarn>$(NoWarn);NU1901;NU1902;NU1903;NU1904</NoWarn>
  </PropertyGroup>
</Project>
