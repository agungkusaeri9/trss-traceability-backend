{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=trss_traceability_system;Uid=your_username;Pwd=your_password;",
    "LoggingDatabase": "Server=localhost;Port=3306;Database=trss_traceability_system_logging;Uid=your_username;Pwd=your_password;"
  },
  "MqttSettings": {
    "Broker": "localhost",
    "Port": 1883,
    "ClientId": "trss-traceability-worker"
  },
  "WorkerSettings": {
    "ApiUrl": "http://localhost:5052"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "CustomLogging": {
    "LogFolder": "logging/logs-worker",
    "ValidationFolder": "validation",
    "DebugIsTerminal": false
  }
}
